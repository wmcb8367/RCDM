{
  "rewrites": [
    {
      "source": "/",
      "destination": "/reader/"
    }
  ],
  "headers": [
    {
      "source": "/reader/audiobook/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/figures/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
